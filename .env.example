# Telegram Bot API — create a bot via @BotFather on Telegram, get the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenPlaceholder

# Your Telegram chat id — message your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id from the JSON,
# or ask @userinfobot.
TELEGRAM_CHAT_ID=123456789

# Optional: enables automatic content-bank top-up via Claude when the bank runs low.
# Leave unset to skip top-up entirely — the curated bank works fine on its own.
ANTHROPIC_API_KEY=
